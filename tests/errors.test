# How a failing child is reported. The caller must be able to tell success from
# failure, and must get the child's own words - the reason the package exists
# is to run commands whose outcome matters, so a status that only reaches the
# terminal is no use to anyone.

package require tcltest 2.5
namespace import -force ::tcltest::*
source [file join [file dirname [info script]] helpers.tcl]

test errors-1.1 {a non-zero exit status raises, with stderr and CHILDSTATUS} -body {
	set rc [catch {::exec_extensions::ttlexec 2000 sh -c {echo out; echo boom >&2; exit 7}} msg opts]
	list $rc [string match {*boom*} $msg] [lindex [dict get $opts -errorcode] 0]
} -result {1 1 CHILDSTATUS}

test errors-1.2 {output on stderr alone raises, as it does for exec} -body {
	set rc [catch {::exec_extensions::ttlexec 2000 sh -c {echo warn >&2; exit 0}} msg]
	list $rc [string match {*warn*} $msg]
} -result {1 1}

test errors-1.3 {exec agrees that stderr alone is an error} -body {
	catch {exec sh -c {echo warn >&2; exit 0}}
} -result 1

test errors-1.4 {what the command printed before failing reaches the caller} -body {
	# exec puts the command's own output in the error it raises. Dropping it
	# leaves the caller diagnosing a failure with the evidence thrown away.
	set rc [catch {::exec_extensions::ttlexec 2000 sh -c {echo OUT; exit 7}} msg]
	list $rc $msg
} -result "1 {OUT\nchild process exited abnormally}"

test errors-1.5 {the error is assembled the way exec assembles it} -body {
	set cmd {sh -c {echo OUT; echo ERR >&2; exit 7}}
	catch {exec {*}$cmd} expected
	catch {::exec_extensions::ttlexec 2000 {*}$cmd} actual
	string equal $expected $actual
} -result 1

test errors-2.1 {a command that cannot be started raises} -body {
	catch {::exec_extensions::ttlexec 1000 no_such_binary_xyz}
} -result 1

test errors-2.2 {a failure to start carries the code exec gives it} -constraints unix -body {
	set rc [catch {::exec_extensions::ttlexec 1000 no_such_binary_xyz} msg opts]
	catch {exec no_such_binary_xyz} expected_msg expected_opts
	list $rc \
	  [string equal $msg $expected_msg] \
	  [string equal [dict get $opts -errorcode] [dict get $expected_opts -errorcode]]
} -result {1 1 1}

test errors-2.3 {tidying up after a failed start does not replace that code} -constraints unix -body {
	# The cleanup runs before the failure is reported, and a catch in it that
	# caught something would leave its own code behind in ::errorCode - which is
	# then what the caller would be handed, under the message about the command
	# that could not be started. Runs apart because it breaks file delete.
	in_child {
		rename file _real_file
		proc file {args} {
			if {[lindex $args 0] eq "delete"} {
				error "cleanup failed"
			}
			return [_real_file {*}$args]
		}
		catch {::exec_extensions::ttlexec 1000 no_such_binary_xyz} msg opts
		puts [lrange [dict get $opts -errorcode] 0 1]
	}
} -result {POSIX ENOENT}

test errors-3.1 {a missing command word is rejected} -body {
	catch {::exec_extensions::ttlexec 100}
} -result 1

test errors-3.2 {a non-integer time to live is rejected} -body {
	catch {::exec_extensions::ttlexec abc printf x}
} -result 1

# A channel that breaks mid-read cannot be arranged on demand, so a transform
# raising from its read method stands in for one. The time to live is disabled
# in both cases below, which leaves nothing but the handling of that failure to
# end the call: an error escaping a file event goes to the background handler,
# and the vwait inside ttlexec would then wait for a wake-up nothing is left to
# give it. The watchdog reports a hang instead of letting the suite stall on one.
set ::breaking_call {
	proc breaker {cmd handle args} {
		switch -- $cmd {
			initialize {return {initialize finalize read}}
			finalize   {return}
			read       {error "broken channel"}
		}
	}
	proc stderr_temp_files {} {
		set name ""
		close [file tempfile name]
		file delete -- $name
		return [glob -nocomplain \
		  [file join [file dirname $name] exec_extensions_stderr*]]
	}
	after 100 {
		foreach k [array names ::exec_extensions::state *,chan] {
			catch {chan push $::exec_extensions::state($k) breaker}
		}
	}
	after 5000 {puts hung; exit 0}
	set before [stderr_temp_files]
	set rc [catch {::exec_extensions::ttlexec 0 sh -c {sleep 1; echo hi}} msg]
}

test errors-4.1 {a failing read ends the call instead of hanging} -constraints unix -body {
	in_child "$::breaking_call\nputs \[list \$rc \$msg]"
} -result {1 {broken channel}}

test errors-4.2 {a failing read leaves nothing behind} -constraints unix -body {
	# Files another run left in the temporary directory must not decide this,
	# so only what this call added is counted.
	in_child "$::breaking_call
		set leaked \[list]
		foreach path \[stderr_temp_files] {
			if {\$path ni \$before} {
				lappend leaked \$path
			}
		}
		puts \[list \[llength \[array names ::exec_extensions::state]] \[llength \$leaked]]"
} -result {0 0}

cleanupTests
