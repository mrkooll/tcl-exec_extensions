# Redirections the caller writes into the command. This package redirects stderr
# for its own purposes, and whatever it appends would be the last word; when the
# caller has already said where stderr goes, that has to be left alone.

package require tcltest 2.5
namespace import -force ::tcltest::*
source [file join [file dirname [info script]] helpers.tcl]

proc scratch {} {
	set path ""
	close [file tempfile path "exec_extensions_test"]
	return $path
}
proc slurp {path} {
	set fh [open $path r]
	set data [read $fh]
	close $fh
	return $data
}
# The count of this package's own stderr scratch files sitting in the temporary
# directory, so a case can tell whether a call made one.
proc stderr_temp_files {} {
	set name ""
	close [file tempfile name]
	file delete -- $name
	return [llength [glob -nocomplain \
	  [file join [file dirname $name] exec_extensions_stderr*]]]
}

test redirect-1.1 {the caller's own 2> receives the text} -setup {
	set path [scratch]
} -body {
	::exec_extensions::ttlexec 2000 sh -c {echo out; echo warn >&2} 2> $path
	slurp $path
} -cleanup {
	file delete -- $path
} -result "warn\n"

test redirect-1.2 {redirected stderr is not a failure} -setup {
	set path [scratch]
} -body {
	# Without the redirection this very command raises - see redirect-3.1.
	::exec_extensions::ttlexec 2000 sh -c {echo out; echo warn >&2} 2> $path
} -cleanup {
	file delete -- $path
} -result out

test redirect-1.3 {a non-zero exit still raises under a redirection} -setup {
	set path [scratch]
} -body {
	set rc [catch {
		::exec_extensions::ttlexec 2000 sh -c {echo out; echo warn >&2; exit 7} 2> $path
	} msg opts]
	list $rc $msg [lindex [dict get $opts -errorcode] 0]
} -cleanup {
	file delete -- $path
} -result "1 {out\nchild process exited abnormally} CHILDSTATUS"

test redirect-1.4 {2>@1 folds stderr into the result, as it does for exec} -body {
	set cmd {sh -c {echo out; echo warn >&2}}
	string equal [::exec_extensions::ttlexec 2000 {*}$cmd 2>@1] [exec {*}$cmd 2>@1]
} -result 1

test redirect-1.5 {an operator glued to the file name counts too} -constraints unix -body {
	::exec_extensions::ttlexec 2000 sh -c {echo out; echo warn >&2} 2>/dev/null
} -result out

test redirect-1.6 {the caller's redirection wins over -ignorestderr} -setup {
	set path [scratch]
} -body {
	set out [::exec_extensions::ttlexec -ignorestderr 2000 \
	  sh -c {echo out; echo warn >&2} 2> $path]
	list $out [slurp $path]
} -cleanup {
	file delete -- $path
} -result "out {warn\n}"

test redirect-2.1 {no scratch file is made when the caller redirects} -constraints unix -body {
	set before [stderr_temp_files]
	::exec_extensions::ttlexec 2000 sh -c {echo warn >&2} 2>/dev/null
	expr {[stderr_temp_files] - $before}
} -result 0

test redirect-3.1 {without a redirection stderr is still an error} -body {
	catch {::exec_extensions::ttlexec 2000 sh -c {echo out; echo warn >&2}} msg
	set msg
} -result "out\nwarn"

cleanupTests
